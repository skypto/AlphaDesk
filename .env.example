ALPHADESK_MODE=PAPER_ONLY
ALPHADESK_ENVIRONMENT=development
ALPHADESK_LOG_LEVEL=INFO
ALPHADESK_DATABASE_URL=postgresql+psycopg://alphadesk:alphadesk_dev@postgres:5432/alphadesk
ALPHADESK_NATS_URL=nats://nats:4222
ALPHADESK_INFRASTRUCTURE_CHECKS=true
ALPHADESK_BROKER_RECONCILIATION_INTERVAL_SECONDS=30
ALPHADESK_BROKER_MAXIMUM_STATE_AGE_SECONDS=90
ALPHADESK_WORKSPACE_CONNECTION_LIMIT=20
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public synthetic demo AI remains deterministic.
LLM_PROVIDER=fixture
ALPHADESK_AI_TIMEOUT_SECONDS=20

# Hosted Supabase Free authentication. The secret key is API-only and must never be public.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ALPHADESK_ADMIN_EMAILS=

# Generate independent values; keep them outside source control in production.
# Master key format: v1:<URL-safe base64 encoding of exactly 32 random bytes>
ALPHADESK_CREDENTIAL_MASTER_KEYS=
# Minimum 32 random characters. Existing demo cookies expire when this changes.
ALPHADESK_DEMO_SESSION_SIGNING_KEY=

# Lightsail-only values used by compose.lightsail.yml
ALPHADESK_HOSTNAME=
POSTGRES_PASSWORD=

# Operator Alpaca and OpenRouter credentials are entered only in Connected Settings.
# LIVE TRADING IS NOT SUPPORTED BY ALPHADESK.
